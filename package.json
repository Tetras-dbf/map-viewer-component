{
  "name": "dbf-map-viewer-component",
  "version": "0.1.0",
  "description": "React component wrapping Mirador to display IIIF maps and manifests in the front office.",
  "type": "module",
  "main": "./dist/map-viewer-component.cjs.js",
  "module": "./dist/map-viewer-component.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/map-viewer-component.es.js",
      "require": "./dist/map-viewer-component.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tetras-dbf/map-viewer-component.git"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:demo": "GITHUB_PAGES=true vite build -c vite.demo.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "mirador": ">=4.2.3",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "mirador": "file:../mirador",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.2"
  }
}
